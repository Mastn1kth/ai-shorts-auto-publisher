# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# Publishing (all optional; use --dry-run to validate without uploading)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube-token.json
# Optional stable identity for deduplication if you manage multiple YouTube channels.
YOUTUBE_ACCOUNT_ID=
YOUTUBE_CATEGORY_ID=22
VK_ACCESS_TOKEN=your_vk_access_token_here
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_PUBLISH_TO_WALL=false
PUBLISH_LEDGER_FILE=output/publishing-ledger.json
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_professional_account_id
INSTAGRAM_API_VERSION=v24.0
INSTAGRAM_SHARE_TO_FEED=true
MEDIA_S3_BUCKET=your_bucket_name
MEDIA_S3_ENDPOINT=https://your-s3-compatible-endpoint.example
MEDIA_PUBLIC_BASE_URL=https://your-public-cdn.example
# Standard AWS credentials are read by boto3 from its credential chain.
INSTAGRAM_POLL_INTERVAL=5
INSTAGRAM_POLL_TIMEOUT=900
